# Development example. Production must use explicit non-default secrets and HTTPS URLs.
CHAT_ENV=development
CHAT_HTTP_ADDR=:8080
CHAT_DATABASE_URL=postgres://chat:chat@postgres:5432/chat?sslmode=disable
CHAT_REDIS_ADDR=redis:6379
CHAT_NATS_URL=nats://nats:4222
CHAT_WEB_ORIGIN=http://localhost:3000
CHAT_MAGIC_LINK_BASE_URL=http://localhost:3000/auth/callback

# Identity providers
CHAT_YANDEX_CLIENT_ID=
CHAT_YANDEX_REDIRECT_URL=http://localhost:8080/api/v1/auth/yandex/callback

# Email delivery. Required in production.
CHAT_SMTP_ADDR=
CHAT_SMTP_USERNAME=
CHAT_SMTP_PASSWORD=
CHAT_SMTP_FROM=CHAT <no-reply@example.com>

# Media storage. For single-node development/local alpha only; production target is object storage/CDN.
CHAT_MEDIA_ROOT=./var/media

# Web client
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
