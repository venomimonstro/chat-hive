# CHAT production template. Copy to a protected server-side env file and replace every placeholder.
CHAT_ENV=production
CHAT_HTTP_ADDR=:8080
CHAT_DATABASE_URL=postgres://chat:CHANGE_ME@postgres:5432/chat?sslmode=disable
CHAT_REDIS_ADDR=redis:6379
CHAT_NATS_URL=nats://nats:4222
CHAT_WEB_ORIGIN=https://chat.example.com
CHAT_MAGIC_LINK_BASE_URL=https://chat.example.com/auth/callback
CHAT_YANDEX_CLIENT_ID=
CHAT_YANDEX_REDIRECT_URL=https://api.chat.example.com/api/v1/auth/yandex/callback
CHAT_SMTP_ADDR=smtp.example.com:587
CHAT_SMTP_USERNAME=
CHAT_SMTP_PASSWORD=CHANGE_ME
CHAT_SMTP_FROM=CHAT <no-reply@example.com>
CHAT_MEDIA_ROOT=/var/lib/chat/media

# Database container only. Keep this file chmod 600 and outside public web roots.
POSTGRES_DB=chat
POSTGRES_USER=chat
POSTGRES_PASSWORD=CHANGE_ME

# Prebuilt web image. Generate web/package-lock.json and build the image through the release gate.
CHAT_WEB_IMAGE=chat-web:local
NEXT_PUBLIC_API_BASE_URL=https://api.chat.example.com
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
