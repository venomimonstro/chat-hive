# CHAT production template. Copy to .env.production, chmod 600, replace every placeholder.
CHAT_ENV=production
CHAT_HTTP_ADDR=:8080

# Public HTTPS entrypoint (Caddy)
CHAT_PUBLIC_HOST=chat.example.ru
CHAT_TLS_EMAIL=ops@example.ru
CHAT_WEB_ORIGIN=https://chat.example.ru
CHAT_MAGIC_LINK_BASE_URL=https://chat.example.ru/auth/callback
CHAT_TRUSTED_PROXY_CIDRS=172.31.238.2/32

# Database
POSTGRES_DB=chat
POSTGRES_USER=chat
POSTGRES_PASSWORD=CHANGE_ME_LONG_RANDOM
CHAT_DATABASE_URL=postgres://chat:CHANGE_ME_LONG_RANDOM@postgres:5432/chat?sslmode=disable

# Internal services (not public)
CHAT_REDIS_ADDR=redis:6379
CHAT_NATS_URL=nats://nats:4222
CHAT_MEDIA_ROOT=/var/lib/chat/media

# Email login
CHAT_SMTP_ADDR=smtp.example.ru:587
CHAT_SMTP_USERNAME=no-reply@example.ru
CHAT_SMTP_PASSWORD=CHANGE_ME
CHAT_SMTP_FROM=CHAT <no-reply@example.ru>

# Yandex ID (optional until configured)
CHAT_YANDEX_CLIENT_ID=
CHAT_YANDEX_REDIRECT_URL=https://chat.example.ru/api/v1/auth/yandex/callback

# Frontend image. Build only after a real web/package-lock.json exists.
CHAT_WEB_IMAGE=chat-web:local

# Browser API defaults to same-origin; normally leave blank.
NEXT_PUBLIC_API_BASE_URL=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Temporary audited first-admin bootstrap only. Do not keep enabled.
# CHAT_ADMIN_BOOTSTRAP_CONFIRM=I_UNDERSTAND
